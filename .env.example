# Copy to .env (repo root) before running `docker-compose up`.
# .env is gitignored - never commit real secrets here.

# Required: signs JWT auth tokens issued by api-gateway. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET_KEY=

# Required for the AI features (design review + /ai/solve) to actually call
# a model instead of failing - get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override which model aliases the AI gateway uses (see
# core-services/ai-agent/ai_agent/config.py)
AI_AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
AI_AGENT_STRUCTURED_MODEL=anthropic/claude-sonnet-4-5
